#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node *left;
    Node *right;
};

// Create a new node
Node* createNode(int value)
{
    Node *newNode = new Node();

    newNode->data = value;
    newNode->left = NULL;
    newNode->right = NULL;

    return newNode;
}

// Insert a node
Node* insert(Node *root, int value)
{
    if (root == NULL)
    {
        return createNode(value);
    }

    // If left is empty, insert on left
    if (root->left == NULL)
    {
        root->left = createNode(value);
        return root;
    }

    // If right is empty, insert on right
    if (root->right == NULL)
    {
        root->right = createNode(value);
        return root;
    }

    // Otherwise, try left subtree
    insert(root->left, value);

    return root;
}

// Find deepest node
Node* findDeepest(Node *root)
{
    if (root == NULL)
        return NULL;

    Node *leftNode = findDeepest(root->left);
    Node *rightNode = findDeepest(root->right);

    if (rightNode != NULL)
        return rightNode;

    if (leftNode != NULL)
        return leftNode;

    return root;
}

// Delete deepest node
void deleteDeepest(Node *root, Node *deepest)
{
    if (root == NULL)
        return;

    if (root->left == deepest)
    {
        delete root->left;
        root->left = NULL;
        return;
    }

    if (root->right == deepest)
    {
        delete root->right;
        root->right = NULL;
        return;
    }

    deleteDeepest(root->left, deepest);
    deleteDeepest(root->right, deepest);
}

// Delete an element
Node* deleteNode(Node *root, int value)
{
    if (root == NULL)
        return NULL;

    // If root itself contains the value
    if (root->data == value)
    {
        // If root has no children
        if (root->left == NULL && root->right == NULL)
        {
            delete root;
            return NULL;
        }

        // Find deepest node
        Node *deepest = findDeepest(root);

        // Replace value
        root->data = deepest->data;

        // Delete deepest node
        deleteDeepest(root, deepest);

        return root;
    }

    // Search left subtree
    if (root->left != NULL)
    {
        root->left = deleteNode(root->left, value);
    }

    // Search right subtree
    if (root->right != NULL)
    {
        root->right = deleteNode(root->right, value);
    }

    return root;
}

// Preorder: Root -> Left -> Right
void preorder(Node *root)
{
    if (root != NULL)
    {
        cout << root->data << " ";
        preorder(root->left);
        preorder(root->right);
    }
}

// Inorder: Left -> Root -> Right
void inorder(Node *root)
{
    if (root != NULL)
    {
        inorder(root->left);
        cout << root->data << " ";
        inorder(root->right);
    }
}

// Postorder: Left -> Right -> Root
void postorder(Node *root)
{
    if (root != NULL)
    {
        postorder(root->left);
        postorder(root->right);
        cout << root->data << " ";
    }
}

int main()
{
    Node *root = NULL;
    int n, value, deleteValue;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements: ";

    for (int i = 0; i < n; i++)
    {
        cin >> value;
        root = insert(root, value);
    }

    cout << "\nPreorder: ";
    preorder(root);

    cout << "\nInorder: ";
    inorder(root);

    cout << "\nPostorder: ";
    postorder(root);

    cout << "\n\nEnter element to delete: ";
    cin >> deleteValue;

    root = deleteNode(root, deleteValue);

    cout << "\nAfter deletion:";

    cout << "\nPreorder: ";
    preorder(root);

    cout << "\nInorder: ";
    inorder(root);

    cout << "\nPostorder: ";
    postorder(root);

    return 0;
}
